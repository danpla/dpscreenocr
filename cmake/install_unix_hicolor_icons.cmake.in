# Install symbolic links to the icons from the share/(app name)/icons
# directory to the standard hicolor icon directory. The script is
# intended for install(SCRIPT ...), after the main icons are already
# installed.

set(ICONS_DIR "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/@CMAKE_INSTALL_DATADIR@/@APP_FILE_NAME@/icons")
if(NOT IS_DIRECTORY "${ICONS_DIR}")
    message(FATAL_ERROR "\"${ICONS_DIR}\" directory does not exist")
endif()

# In case if a relative DESTDIR is set, make the path absolute so that
# RELATIVE in file(GLOB) works correctly.
cmake_path(ABSOLUTE_PATH ICONS_DIR OUTPUT_VARIABLE ICONS_DIR)
file(GLOB SIZES RELATIVE "${ICONS_DIR}" "${ICONS_DIR}/*")

if(NOT SIZES)
    message(FATAL_ERROR "No icon sizes collected in \"${ICONS_DIR}\"")
endif()

foreach(SIZE ${SIZES})
    if(SIZE STREQUAL "scalable")
        set(DST_SIZE_DIR "${SIZE}")
        set(EXT ".svg")
    else()
        set(DST_SIZE_DIR "${SIZE}x${SIZE}")
        set(EXT ".png")
    endif()

    # The app icon is the only icon we need in the hicolor directory,
    # because it's used in system menus and can possibly be overridden
    # by custom icon themes.
    set(FILE_NAME "@APP_FILE_NAME@${EXT}")

    # We must install symlinks using file(INSTALL) so that paths are
    # added to the install_manifest.txt file that we use for the
    # "uninstall" target.
    #
    # Technically, it seems possible to create a symlink in the final
    # location and then "install" it to its own directory, but that
    # looks like a hack, so we use a fair approach using a temporary
    # file instead.
    set(TMP_SYMLINK_PATH "@CMAKE_BINARY_DIR@/${FILE_NAME}")

    file(
        CREATE_LINK
        # A hicolor icon resides in:
        #   (install prefix)/share/icons/hicolor/(size)/(category)/
        # Therefore, we need to skip 4 parent directories to get to
        # the "share" dir.
        "../../../../@APP_FILE_NAME@/icons/${SIZE}/${FILE_NAME}"
        "${TMP_SYMLINK_PATH}"
        SYMBOLIC)
    file(
        INSTALL
        "${TMP_SYMLINK_PATH}"
        # Note that there is no $ENV{DESTDIR} here; file(INSTALL) adds
        # it automatically.
        DESTINATION "${CMAKE_INSTALL_PREFIX}/@CMAKE_INSTALL_DATADIR@/icons/hicolor/${DST_SIZE_DIR}/apps")

    file(REMOVE "${TMP_SYMLINK_PATH}")
endforeach()
